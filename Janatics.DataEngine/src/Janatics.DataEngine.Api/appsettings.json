{
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "janatics-dataengine",
      "Audience": "janatics-dataengine-clients",
      "SigningKey": "replace-this-dev-signing-key-with-a-secure-secret"
    }
  },
  "Redis": {
    "ConnectionString": ""
  },
  "DataEngine": {
    "EnableResilience": true,
    "EnableAudit": true,
    "RequireMasterTables": true,
    "MaxRetryCount": 3,
    "OperationTimeoutSeconds": 30,
    "LogsFolderPath": "logs",
    "DatabaseConfig": {
      "ConnectionString": "",
      "Provider": "PostgreSQL",
      "DefaultTimezone": "UTC",
      "ConnectionIdleLifetimeMinutes": 15,
      "MaxPoolSize": 20,
      "MinPoolSize": 5,
      "EnablePooling": true,
      "CommandTimeoutSeconds": 60,
      "ConnectionTimeoutSeconds": 30,
      "MaxRetryCount": 3,
      "EnableConnectionMultiplexing": false,
      "EnablePerformanceMetrics": true,
      "MaxConcurrentOperations": 10
    },
    "FetchService": {
      "SchemaName": "public",
      "QueryDefinitionTableName": "fetchquerydefinition",
      "QueryTableMapTableName": "fetchquerytablemap",
      "QueryAuditLogTableName": "fetchqueryauditlog",
      "AllowDirectQueryExecution": true,
      "MaxDirectQueryLength": 10000,
      "DefaultPageSize": 100,
      "MaxPageSize": 1000
    }
  },
  "AllowedHosts": "*"
}
